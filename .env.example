# ============================================================================
# Minecraft AFK Client Management Service — Environment Configuration Example
# Copy this file to `.env` (backend/.env) and fill in real values.
# NEVER commit the real `.env` file to version control.
# ============================================================================

# ---- Server ----
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# Timezone used for the backend container's clock — controls when "Daily"
# auto-command times and other scheduled tasks actually fire. Should match
# the timezone your browser/users are in (an IANA name, e.g. Europe/Berlin,
# America/New_York). Defaults to Europe/Berlin if unset.
TZ=Europe/Berlin
# Public origin the frontend is served from (used for CORS + secure cookies).
# In production with the provided docker-compose + Caddy setup, frontend and
# API are served from the SAME origin/domain, so this mainly matters for
# local development where the Vite dev server runs on a different port.
PUBLIC_ORIGIN=https://afk.example.com

# ---- Reverse proxy / domain (docker-compose "web" / Caddy service) ----
# Your public domain, managed via Cloudflare DNS. Leave unset (":80") to let
# Cloudflare or another upstream proxy terminate HTTPS instead of Caddy.
SITE_ADDRESS=afk.example.com

# ---- Cloudflare Tunnel (optional, recommended for a home Raspberry Pi) ----
# Lets Cloudflare reach the site through an outbound-only connection, so you
# do NOT need router port forwarding or a public IP. Create a tunnel at
# Cloudflare Zero Trust -> Networks -> Tunnels, add a public hostname pointing
# to the service URL http://web:80, then paste the connector token here and
# start the stack with: docker compose --profile tunnel up -d
# When using a Tunnel, keep SITE_ADDRESS=:80 (Cloudflare handles HTTPS).
TUNNEL_TOKEN=

# ---- Database ----
# NOTE: Prisma resolves relative SQLite paths relative to the location of
# backend/prisma/schema.prisma, so "../data/afk.db" actually resolves to
# backend/data/afk.db (matches the Docker volume mount and backup scripts).
DATABASE_URL="file:../data/afk.db"

# ---- Session / Security ----
# Long random string used to sign/validate session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie name for the session identifier
SESSION_COOKIE_NAME=afk_session
# Session lifetime in hours
SESSION_TTL_HOURS=168
# Set to "true" when served over HTTPS (production). Keep "false" only for local http dev.
SESSION_COOKIE_SECURE=true
# Optional dedicated key for encrypting sensitive data at rest (proxy
# credentials). If unset, SESSION_SECRET is used. Set a distinct value in
# production. Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# ---- Initial Admin Bootstrap ----
# Used ONLY on first startup when no ADMIN user exists yet in the database.
# After the admin is created, these values are no longer read/used.
INITIAL_ADMIN_USERNAME=Desmo
INITIAL_ADMIN_PASSWORD=change-me

# ---- Rate Limiting ----
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# ---- Logging ----
LOG_LEVEL=info

# ---- CORS ----
# Comma-separated list of allowed origins for the API (frontend URLs).
# Only relevant when frontend and backend are on different origins (local
# dev: Vite on :5173 vs API on :4000). In the docker-compose/Caddy production
# setup they share one origin, so CORS is not on the critical path there.
CORS_ORIGINS=http://localhost:5173
