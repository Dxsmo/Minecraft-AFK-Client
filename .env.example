# ============================================================================
# Minecraft AFK Client Management Service — Environment Configuration Example
# Copy this file to `.env` (backend/.env) and fill in real values.
# NEVER commit the real `.env` file to version control.
# ============================================================================

# ---- Server ----
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# Public origin the frontend is served from (used for CORS + secure cookies)
PUBLIC_ORIGIN=https://afk.example.com

# ---- Database ----
DATABASE_URL="file:./data/afk.db"

# ---- Session / Security ----
# Long random string used to sign/validate session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Cookie name for the session identifier
SESSION_COOKIE_NAME=afk_session
# Session lifetime in hours
SESSION_TTL_HOURS=168
# Set to "true" when served over HTTPS (production). Keep "false" only for local http dev.
SESSION_COOKIE_SECURE=true

# ---- Initial Admin Bootstrap ----
# Used ONLY on first startup when no ADMIN user exists yet in the database.
# After the admin is created, these values are no longer read/used.
INITIAL_ADMIN_USERNAME=Desmo
INITIAL_ADMIN_PASSWORD=change-me

# ---- Rate Limiting ----
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=1 minute

# ---- Logging ----
LOG_LEVEL=info

# ---- CORS ----
# Comma-separated list of allowed origins for the API (frontend URLs)
CORS_ORIGINS=http://localhost:5173
