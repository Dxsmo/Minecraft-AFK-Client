# syntax=docker/dockerfile:1
# For Bedrock/website updates only: retain the Java binary from the installed
# backend image. scripts/update-bedrock.sh supplies that local image explicitly.
ARG BACKEND_BASE_IMAGE

FROM node:24-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ cmake openssl \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
RUN --mount=type=cache,id=afk-backend-npm,target=/root/.npm,sharing=locked npm ci
COPY prisma ./prisma
RUN npx prisma generate
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM ${BACKEND_BASE_IMAGE} AS runtime
WORKDIR /app
# COPY alone would leave modules removed from the source tree on disk.
RUN rm -rf /app/dist /app/node_modules /app/prisma
COPY package.json package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY prisma ./prisma
# The base supplies the same Node 24/Debian runtime, Java executable, data
# volume, startup migration command, and healthcheck as the installed backend.
