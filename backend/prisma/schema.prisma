// Prisma schema for the Minecraft AFK Client Management Service
// Database: SQLite (file-based, lightweight, ideal for Raspberry Pi 5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthType {
  OFFLINE
  MICROSOFT
}

enum AutoButton {
  OFF
  LEFT
  RIGHT
}

enum ClientStatus {
  OFFLINE
  CONNECTING
  ONLINE
  DISCONNECTING
  RECONNECTING
  ERROR
}

enum ConsoleLogType {
  SYSTEM
  CHAT
  SERVER_MESSAGE
  USER_COMMAND
  ERROR
  WARNING
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  minecraftUsername String?
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?
  // Personal dashboard layout, independent of devices and other users.
  dashboardPreferences String?
  // Explicit website announcements only; independent of app/build versions.
  lastSeenWebsiteUpdate String?

  sessions              Session[]
  assignments           UserMinecraftAccount[]
  auditLogs             AuditLog[]
  createdAccounts       MinecraftAccount[]     @relation("CreatedAccounts")
  createdIpBans         BannedIp[]             @relation("CreatedIpBans")
  notes                 Note[]                @relation("OwnedNotes")
  noteGrants            NoteGrant[]
}

model Note {
  id        String   @id @default(cuid())
  title     String   @default("Neue Notiz")
  content   String   @default("{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]}")
  revision  Int      @default(0)
  ownerId   String
  owner     User     @relation("OwnedNotes", fields: [ownerId], references: [id], onDelete: Cascade)
  grants    NoteGrant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model NoteGrant {
  noteId   String
  userId   String
  canWrite Boolean @default(false)
  note     Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  csrfToken String
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MinecraftAccount {
  id                         String       @id @default(cuid())
  name                       String       @unique
  // Java and Bedrock are driven by the shared SoulFire service.
  edition                    String       @default("JAVA")
  // Optional website-only display label. Unlike `name` (which doubles as the
  // offline join username and therefore must be a valid Minecraft name), this
  // is purely cosmetic and may contain spaces etc. Empty means "fall back to
  // name". Editable at any time without touching the join identity.
  displayName                String       @default("")
  // Empty selects automatic Java server detection / the installed Bedrock codec.
  minecraftVersion           String       @default("")
  serverHost                 String
  serverPort                 Int          @default(25565)
  authType                   AuthType     @default(OFFLINE)
  // Credentials are stored encrypted-at-rest is out of scope for SQLite text column here,
  // but this field is NEVER exposed via the API to any client (see accounts service).
  // For MICROSOFT accounts, credentialsSecret holds the email and credentialsPassword
  // holds the account password. Both are set ONLY at account creation time and are
  // immutable afterwards (the update API does not accept these fields at all) — to
  // change them, the account must be deleted and recreated.
  credentialsSecret          String?
  credentialsPassword        String?
  // When enabled, the bot continuously sneaks/crouches.
  crouchEnabled              Boolean      @default(false)
  autoButton                 AutoButton   @default(OFF)
  autoReconnect              Boolean      @default(true)
  // Free-form short note shown in the dashboard/settings (e.g. "farming cobble").
  notes                      String       @default("")
  // Legacy auto-home/command columns retained for database compatibility.
  // No longer read, scheduled, configurable or exposed by the API.
  autoCommandEnabled         Boolean      @default(false)
  autoCommandText            String       @default("")
  autoCommandIntervalMinutes Int          @default(5)
  autoCommandSpanEnabled     Boolean      @default(false)
  autoCommandSpanMinSeconds  Int          @default(600)
  autoCommandSpanMaxSeconds  Int          @default(1800)
  // Legacy auto-TPA columns, unused and no longer exposed by the API.
  tpAutoEnabled              Boolean      @default(false)
  tpAutoAllowlist            String       @default("[]")
  // Periodically run the sell command and shift all items into the sell menu.
  autoSellEnabled            Boolean      @default(false)
  autoSellIntervalSeconds    Float        @default(60)
  autoSellCommand            String       @default("/sell")
  // Last confirmed sale survives earnings-history cleanup and client restarts.
  lastSellAt                 DateTime?
  // Legacy daily auto-home scheduler columns, unused.
  dailyCommandEnabled        Boolean      @default(false)
  dailyCommandTimes          String       @default("[]")
  // Legacy balance columns retained for database compatibility; no longer used.
  balanceEnabled             Boolean      @default(false)
  balanceCommand             String       @default("/balance")
  // Legacy stored balance, no longer exposed or refreshed.
  lastBalance                Float?
  lastBalanceAt              DateTime?
  // Legacy homes cache, unused. No automatic /homes queries are sent.
  homesJson                  String       @default("[]")
  // Spawner handling. `spawnerType` selects which mob spawner this account is
  // parked at ("" = unconfigured), which in turn determines the item types the
  // spawner produces. `spawnerActions` maps each of those item ids to what
  // should happen to it when the spawner is cleared:
  //   { "minecraft:beef": "drop" | "sell" | "keep" }
  // Dropping is always performed before selling, and both stop once fewer than
  // two stacks of the item remain.
  spawnerType                String       @default("")
  spawnerActions             String       @default("{}")
  // Legacy columns retained for existing SQLite databases; scheduling is disabled.
  spawnerClearEnabled        Boolean      @default(false)
  spawnerClearTimes          String       @default("[]")
  status                     ClientStatus @default(OFFLINE)
  // Persistent dashboard ordering key (smaller = earlier in list).
  dashboardOrder             Int          @default(0)
  // Persisted "should be running" intent: set when the user starts a client and
  // cleared when they stop it. On process/host restart the manager re-connects
  // every account whose autoStart is true, so previously-active bots come back
  // up automatically while stopped ones stay offline.
  autoStart                  Boolean      @default(false)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  // The website user who created this account. Nullable so accounts survive
  // the deletion of their creator (the reference is simply cleared).
  createdById String?
  createdBy   User?   @relation("CreatedAccounts", fields: [createdById], references: [id], onDelete: SetNull)

  assignments  UserMinecraftAccount[]
  consoleLogs  ConsoleLog[]
  sellEarnings SellEarning[]
  image        AccountImage?
  @@index([dashboardOrder, name])
}

// Shared website image, kept separate so bot configuration reads never load it.
model AccountImage {
  minecraftAccountId String           @id
  account            MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  data               Bytes
  revision           String
  updatedAt          DateTime         @updatedAt
}

// One row per confirmed sell payout, used to compute the
// rolling 5m/1h/24h earnings shown under the console. Kept separate from other
// income so only genuine /sell earnings are counted.
model SellEarning {
  id                 String           @id @default(cuid())
  minecraftAccountId String
  account            MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  amount             Float
  createdAt          DateTime         @default(now())

  @@index([minecraftAccountId, createdAt, amount])
  @@index([createdAt])
}

model UserMinecraftAccount {
  id                 String   @id @default(cuid())
  userId             String
  minecraftAccountId String
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, minecraftAccountId])
  @@index([minecraftAccountId])
}

model ConsoleLog {
  id                 String         @id @default(cuid())
  minecraftAccountId String
  type               ConsoleLogType
  message            String
  createdAt          DateTime       @default(now())

  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@index([minecraftAccountId, createdAt, id])
}

// targetType/targetId form a generic polymorphic reference (e.g. "MinecraftAccount"/"<id>" or
// "User"/"<id>") deliberately without a DB-level FK, since the target can be different entities.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// IP addresses blocked from accessing the service. Enforced by a global
// preHandler (see app.ts). Rows may be created manually by an admin or
// automatically after repeated failed logins from the same address.
model BannedIp {
  ip        String   @id
  reason    String?
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("CreatedIpBans", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
