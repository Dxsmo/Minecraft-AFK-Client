// Prisma schema for the Minecraft AFK Client Management Service
// Database: SQLite (file-based, lightweight, ideal for Raspberry Pi 5)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuthType {
  OFFLINE
  MICROSOFT
}

enum ClientStatus {
  OFFLINE
  CONNECTING
  ONLINE
  DISCONNECTING
  RECONNECTING
  ERROR
}

enum ConsoleLogType {
  SYSTEM
  CHAT
  SERVER_MESSAGE
  USER_COMMAND
  ERROR
  WARNING
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  sessions        Session[]
  assignments     UserMinecraftAccount[]
  auditLogs       AuditLog[]
  createdAccounts MinecraftAccount[]     @relation("CreatedAccounts")
  createdSniperAccounts SniperAccount[]  @relation("CreatedSniperAccounts")
  createdIpBans   BannedIp[]             @relation("CreatedIpBans")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  csrfToken String
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MinecraftAccount {
  id                 String   @id @default(cuid())
  name               String   @unique
  // Reserved for future Bedrock support. Azalea speaks the Java protocol only,
  // so this is always "JAVA" today and is intentionally NOT exposed in the
  // create/update API or UI (see docs/LIMITATIONS.md). A future Bedrock bot
  // binary would branch on this in ClientManager without touching the Java path.
  edition            String   @default("JAVA")
  // Optional website-only display label. Unlike `name` (which doubles as the
  // offline join username and therefore must be a valid Minecraft name), this
  // is purely cosmetic and may contain spaces etc. Empty means "fall back to
  // name". Editable at any time without touching the join identity.
  displayName        String   @default("")
  // Empty string means "auto-detect" — MinecraftClient lets mineflayer ping
  // the server and negotiate whichever protocol version it actually
  // reports, rather than forcing a possibly-mismatched hardcoded version.
  minecraftVersion   String   @default("")
  serverHost         String
  serverPort         Int      @default(25565)
  authType           AuthType @default(OFFLINE)
  // Credentials are stored encrypted-at-rest is out of scope for SQLite text column here,
  // but this field is NEVER exposed via the API to any client (see accounts service).
  // For MICROSOFT accounts, credentialsSecret holds the email and credentialsPassword
  // holds the account password. Both are set ONLY at account creation time and are
  // immutable afterwards (the update API does not accept these fields at all) — to
  // change them, the account must be deleted and recreated.
  credentialsSecret   String?
  credentialsPassword String?
  afkEnabled         Boolean  @default(true)
  movementEnabled    Boolean  @default(false)
  // When enabled, the bot continuously sneaks/crouches (re-applied every tick).
  crouchEnabled      Boolean  @default(false)
  afkIntervalSeconds Int      @default(30)
  autoReconnect      Boolean  @default(true)
  // Free-form short note shown in the dashboard/settings (e.g. "farming cobble").
  notes              String   @default("")
  // Automatically types a configured chat message/command at a fixed interval,
  // independent of the AFK/movement behaviors.
  autoCommandEnabled         Boolean @default(false)
  autoCommandText            String  @default("")
  autoCommandIntervalMinutes Int     @default(5)
  // Optional random interval mode for auto-command. When enabled, the command
  // is sent repeatedly with a freshly random delay between min/max after each run.
  autoCommandSpanEnabled     Boolean @default(false)
  autoCommandSpanMinSeconds  Int     @default(600)
  autoCommandSpanMaxSeconds  Int     @default(1800)
  // Auto-accept incoming /tpa teleport requests (never /tpahere).
  tpAutoEnabled              Boolean @default(false)
  // JSON-encoded array of Minecraft names; when non-empty, only /tpa requests
  // from these players are auto-accepted. Empty ("[]") means accept from anyone.
  tpAutoAllowlist            String  @default("[]")
  // Periodically run the sell command and shift all items into the sell menu.
  autoSellEnabled            Boolean @default(false)
  autoSellIntervalSeconds    Float   @default(60)
  autoSellCommand            String  @default("/sell")
  // Daily scheduler for the existing auto-command text: when enabled, the
  // configured autoCommandText is run once at each time of day listed in
  // dailyCommandTimes (JSON-encoded array of "HH:MM", server local time).
  dailyCommandEnabled        Boolean @default(false)
  dailyCommandTimes          String  @default("[]")
  // Periodically query and display the player's balance (parsed from chat).
  balanceEnabled             Boolean @default(false)
  balanceCommand             String  @default("/balance")
  // Last known balance and when it was read, so the dashboard can show a value
  // immediately after a restart before the next poll runs.
  lastBalance                Float?
  lastBalanceAt              DateTime?
  // JSON-encoded array of discovered /homes names for this account, refreshed
  // after every successful server join.
  homesJson           String  @default("[]")
  // Spawner handling. `spawnerType` selects which mob spawner this account is
  // parked at ("" = unconfigured), which in turn determines the item types the
  // spawner produces. `spawnerActions` maps each of those item ids to what
  // should happen to it when the spawner is cleared:
  //   { "minecraft:beef": "drop" | "sell" | "keep" }
  // Dropping is always performed before selling, and both stop once fewer than
  // two stacks of the item remain. When `spawnerClearEnabled` is set, the clear
  // routine also runs automatically at each "HH:MM" in `spawnerClearTimes`.
  spawnerType         String  @default("")
  spawnerActions      String  @default("{}")
  spawnerClearEnabled Boolean @default(false)
  spawnerClearTimes   String  @default("[]")
  status             ClientStatus @default(OFFLINE)
  // Persistent dashboard ordering key (smaller = earlier in list).
  dashboardOrder     Int      @default(0)
  // Persisted "should be running" intent: set when the user starts a client and
  // cleared when they stop it. On process/host restart the manager re-connects
  // every account whose autoStart is true, so previously-active bots come back
  // up automatically while stopped ones stay offline.
  autoStart          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // The website user who created this account. Nullable so accounts survive
  // the deletion of their creator (the reference is simply cleared).
  createdById String?
  createdBy   User?   @relation("CreatedAccounts", fields: [createdById], references: [id], onDelete: SetNull)

  assignments UserMinecraftAccount[]
  consoleLogs ConsoleLog[]
  sellEarnings SellEarning[]
}

// Progress of the "item worth" price scan. Exactly one row exists (id
// "global"): prices are a property of the *server*, not of an account, so the
// scan is a single site-wide job that spreads its `/worth` queries round-robin
// over several bots to stay inconspicuous.
model ItemWorthScan {
  id String @id @default("global")

  // IDLE | RUNNING | PAUSED | COMPLETED | CANCELLED
  status String @default("IDLE")
  // Index of the next item to query, into the generated ITEM_REGISTRY array.
  cursor Int    @default(0)
  total  Int    @default(0)
  // Monotonic counter; incremented when a scan starts. Lets the UI tell a
  // first-ever scan (no comparison possible) from a repeat scan.
  scanNumber   Int @default(0)
  // Items whose price differed from the previous scan, for the current run.
  changedCount Int @default(0)
  // Items no selected bot answered for in the current run.
  missedCount  Int @default(0)
  // False when the scan was parked because it gave up (miss limit hit, or the
  // loop crashed) rather than because every selected bot went offline. Only a
  // resumable pause is picked up again automatically.
  resumable    Boolean @default(true)

  // Seconds between two queries, counted globally across all selected bots.
  delaySeconds Int    @default(5)
  // JSON array of MinecraftAccount ids taking part in this scan.
  accountIdsJson String @default("[]")
  // The archived run the current scan writes its prices into.
  runId          String?

  lastItemId String?
  lastError  String?
  // JSON snapshot of the chat lines received during the last unanswered query.
  // Diagnostic only: /worth reply wording is server-specific, so when nothing
  // is understood the admin needs to see what actually came back.
  lastSamplesJson String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// The most recently scanned worth of a single item, plus the value the previous
// scan recorded so the UI can highlight changes ("off metas"). `value` is null
// when the server reports no configured price. Not tied to an account: whichever
// bot happened to ask, the answer is the same server-wide price.
model ItemWorthValue {
  id String @id @default(cuid())

  itemId   String @unique
  itemName String

  value Float?
  // Distinguishes "previous scan recorded no price" from "never scanned before".
  hasPrevious   Boolean @default(false)
  previousValue Float?

  scanNumber Int       @default(0)
  changedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([changedAt])
}

// One row per money amount earned from an auto-sell action, used to compute the
// rolling 5m/1h/24h earnings shown under the console. Kept separate from other
// income so only genuine /sell earnings are counted.
model SellEarning {
  id                String   @id @default(cuid())
  minecraftAccountId String
  account           MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)
  amount            Float
  createdAt         DateTime @default(now())

  @@index([minecraftAccountId, createdAt])
}

model UserMinecraftAccount {
  id                 String @id @default(cuid())
  userId             String
  minecraftAccountId String
  createdAt          DateTime @default(now())

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, minecraftAccountId])
  @@index([minecraftAccountId])
}

model ConsoleLog {
  id                 String         @id @default(cuid())
  minecraftAccountId String
  type               ConsoleLogType
  message            String
  createdAt          DateTime       @default(now())

  minecraftAccount MinecraftAccount @relation(fields: [minecraftAccountId], references: [id], onDelete: Cascade)

  @@index([minecraftAccountId, createdAt])
}

// targetType/targetId form a generic polymorphic reference (e.g. "MinecraftAccount"/"<id>" or
// "User"/"<id>") deliberately without a DB-level FK, since the target can be different entities.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// A "Name Sniper" account: a Microsoft/Minecraft account that a background
// subprocess continuously tries to rename to a desired name. Completely
// independent of MinecraftAccount (no shared rows, no shared subprocess type)
// even though it reuses the same ClientStatus/ConsoleLogType enums and the
// same NDJSON-over-stdio subprocess pattern (see SniperClient/SniperManager).
// Admin-only feature end to end (API, websocket, UI nav item).
model SniperAccount {
  id              String       @id @default(cuid())
  // Cosmetic label shown in the list; the email is what's actually used to sign in.
  label           String       @default("")
  email           String       @unique
  desiredName     String       @default("")
  // 1-60 seconds between rename attempts, enforced in the zod schema.
  cooldownSeconds Int          @default(5)
  // When true, the sniper detects HTTP 429 (rate limited) responses from
  // Mojang and backs off (honoring a Retry-After header if present, else an
  // increasing delay) instead of retrying at the normal cooldown.
  rateLimitProtection Boolean  @default(false)
  // Optional newline-separated list of proxy URLs (http/https/socks5). When
  // set, the sniper runs one independent request strand per proxy so attempts
  // are spread across multiple outbound IPs (each with its own per-IP limit).
  proxies         String       @default("")
  // Persisted "should be running" intent, mirrors MinecraftAccount.autoStart.
  enabled         Boolean      @default(false)
  status          ClientStatus @default(OFFLINE)
  // The account's current in-game name, updated whenever a rename succeeds or
  // the account authenticates (best-effort; may lag behind reality otherwise).
  currentName     String?
  lastAttemptAt   DateTime?
  lastResult      String?
  lastSuccess     Boolean      @default(false)
  dashboardOrder  Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdById String?
  createdBy   User?   @relation("CreatedSniperAccounts", fields: [createdById], references: [id], onDelete: SetNull)

  logs SniperLog[]
}

model SniperLog {
  id              String         @id @default(cuid())
  sniperAccountId String
  type            ConsoleLogType
  message         String
  createdAt       DateTime       @default(now())

  sniperAccount SniperAccount @relation(fields: [sniperAccountId], references: [id], onDelete: Cascade)

  @@index([sniperAccountId, createdAt])
}

// IP addresses blocked from accessing the service. Enforced by a global
// preHandler (see app.ts). Rows may be created manually by an admin or
// automatically after repeated failed logins from the same address.
model BannedIp {
  ip        String   @id
  reason    String?
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())

  createdById String?
  createdBy   User?   @relation("CreatedIpBans", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// One archived scan. The live ItemWorthValue table only ever holds the newest
// price per item; these rows keep every past run intact so an admin can go back
// and compare against any earlier snapshot, not just the previous one.
model ItemWorthRun {
  id         String @id @default(cuid())
  // Mirrors ItemWorthScan.scanNumber, so runs are addressable by "Scan #3".
  scanNumber Int    @unique
  // RUNNING | COMPLETED | CANCELLED | PAUSED
  status     String @default("RUNNING")

  delaySeconds   Int    @default(5)
  accountIdsJson String @default("[]")
  changedCount   Int    @default(0)
  missedCount    Int    @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  values ItemWorthRunValue[]

  @@index([scanNumber])
}

// One item's price as recorded by one specific run.
model ItemWorthRunValue {
  id    String       @id @default(cuid())
  runId String
  run   ItemWorthRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  itemId   String
  itemName String
  // null when the server reported no configured price.
  value    Float?
  // What the previous run had, so an archived run is readable on its own.
  previousValue Float?

  recordedAt DateTime @default(now())

  @@unique([runId, itemId])
  @@index([runId, recordedAt])
}
