{
  "name": "afk-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft AFK Client Management Service - backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "audit": "npm audit --omit=dev",
    "test": "DATABASE_URL=\"file:../data/test.db\" SESSION_SECRET=test-secret-value-1234567890 NODE_ENV=test INITIAL_ADMIN_PASSWORD= LOG_LEVEL=silent vitest run",
    "test:watch": "DATABASE_URL=\"file:../data/test.db\" SESSION_SECRET=test-secret-value-1234567890 NODE_ENV=test INITIAL_ADMIN_PASSWORD= LOG_LEVEL=silent vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.2.1",
    "@soulfiremc/sdk": "2.10.6",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "effect": "4.1.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.0.1",
    "minecraft-assets": "^1.18.0",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pngjs": "^7.0.0",
    "prisma": "^6.2.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "bedrock-protocol": "3.60.1",
    "prismarine-block": "1.23.0",
    "prismarine-registry": "1.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "cmake-js": {
      "axios": "^0.34.0",
      "tar": "^7.5.22"
    },
    "@azure/msal-node": {
      "uuid": "^11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
