{
  "name": "afk-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minecraft AFK Client Management Service - backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "DATABASE_URL=\"file:../data/test.db\" SESSION_SECRET=test-secret-value-1234567890 NODE_ENV=test INITIAL_ADMIN_PASSWORD= LOG_LEVEL=silent vitest run",
    "test:watch": "DATABASE_URL=\"file:../data/test.db\" SESSION_SECRET=test-secret-value-1234567890 NODE_ENV=test INITIAL_ADMIN_PASSWORD= LOG_LEVEL=silent vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "bedrock-protocol": "^3.58.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "nanoid": "^5.0.9",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "argon2@0.41.1": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
