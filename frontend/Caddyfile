# Caddyfile served by the "web" container.
#
# SITE_ADDRESS controls what Caddy listens on:
#   - Local/dev or when Cloudflare terminates TLS (Flexible/Full mode): ":80"
#   - Production with your own domain (Caddy auto-HTTPS via Let's Encrypt):
#       SITE_ADDRESS=afk.example.com
#     (requires ports 80+443 reachable from the internet, or use Cloudflare
#     "Full (strict)" mode with a Cloudflare Origin Certificate instead —
#     see docs/DEPLOYMENT.md)
{$SITE_ADDRESS}

encode gzip zstd
log {
	output stdout
	format console
}

# API + WebSocket traffic goes to the backend container.
# The mod uses an API-only gateway. It never serves website pages or the
# admin endpoints; Minecraft proof and lobby authorization still run in Fastify.
@ghgames path /ghgames /ghgames/*
handle @ghgames {
	uri strip_prefix /ghgames
	@player_api path /api/health /api/minigames/auth/challenge /api/minigames/auth/session /api/minigames/content /api/minigames/photos /api/minigames/photos/* /ws/minigames
	handle @player_api {
		reverse_proxy backend:4000
	}
	handle {
		respond "Not found" 404
	}
}

handle /api/* {
	reverse_proxy backend:4000
}
handle /ws/* {
	reverse_proxy backend:4000
}

# Vite filenames include a content hash, so repeat visits can reuse assets.
header /assets/* Cache-Control "public, max-age=31536000, immutable"
# Revalidate HTML so a deploy never pins the browser to an old entrypoint.

# Everything else is the React SPA static build, with client-side routing
# fallback to index.html.
handle {
	root * /srv
	# Keep this order explicit: match HTML after the SPA fallback rewrite.
	route {
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}
}

# Basic hardening headers (defense in depth in addition to backend headers).
header {
	# HSTS: enforce HTTPS for a year including subdomains. Cloudflare/Caddy
	# terminate TLS in front of this, so clients only ever see HTTPS.
	Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	X-Frame-Options "DENY"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "no-referrer"
	Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' wss://{host} ws://{host}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	# Don't advertise the server software.
	-Server
}
